# Required — PostgreSQL connection string
# Hosted providers (Neon, Supabase, Vercel Postgres) usually need SSL.
DATABASE_URL=postgresql://edgelog:edgelog@localhost:5432/edgelog

# Required — secret used to sign session cookies (min 32 chars)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of this app (no trailing slash).
# On Vercel previews you can omit this and VERCEL_URL will be used.
# For a custom domain, set this to https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000

# Optional — force SSL for Postgres (auto-detected for Neon/Supabase/AWS)
# PGSSL=true
